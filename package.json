{
  "name": "@ljwei-stak/dsh-mv-cli",
  "version": "0.6.0",
  "type": "module",
  "description": "Terminal-style music video player for DeepSeek Harness Desktop: canvas MVs synced to your own audio file (built-in world.execute(me) ASCII scenes, a real-time port of MisakaZentai's world-execute-me-dsh-pv, or a generic spectrum + lyrics renderer) and MV packs (mv.json) for any song. Unofficial fan work; no audio, video or lyrics are bundled. Includes CC BY-NC-SA 4.0 artwork in .dsh-plugin/assets/dsh-pv-art (see NOTICE.md).",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ascii",
    "music-video",
    "canvas",
    "lyrics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-Marx/dsh-mv-cli.git"
  },
  "homepage": "https://github.com/Alice-Marx/dsh-mv-cli#readme",
  "bugs": {
    "url": "https://github.com/Alice-Marx/dsh-mv-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    ".dsh-plugin/index.mjs",
    ".dsh-plugin/remote-service.mjs",
    ".dsh-plugin/client.js",
    ".dsh-plugin/assets/dsh-pv/",
    ".dsh-plugin/assets/dsh-pv-art/",
    ".dsh-plugin/engine/dsh_mv_engine.py",
    ".dsh-plugin/shared/mv-agent-tools.mjs",
    ".dsh-plugin/shared/mv-ai-pack.mjs",
    ".dsh-plugin/shared/mv-ai-prompt.mjs",
    ".dsh-plugin/shared/mv-ai-upload.mjs",
    ".dsh-plugin/shared/mv-audio.mjs",
    ".dsh-plugin/shared/mv-audio-protocol.mjs",
    ".dsh-plugin/shared/mv-calib-protocol.mjs",
    ".dsh-plugin/shared/mv-dshpv-assets.mjs",
    ".dsh-plugin/shared/mv-dshpv-protocol.mjs",
    ".dsh-plugin/shared/mv-engine.mjs",
    ".dsh-plugin/shared/mv-engine-protocol.mjs",
    ".dsh-plugin/shared/mv-lrclib.mjs",
    ".dsh-plugin/shared/mv-pack-edit.mjs",
    ".dsh-plugin/shared/mv-pack.mjs",
    ".dsh-plugin/shared/mv-pack-host.mjs",
    ".dsh-plugin/shared/mv-pack-template.mjs",
    ".dsh-plugin/shared/mv-lyrics.mjs",
    ".dsh-plugin/shared/mv-remote.mjs",
    ".dsh-plugin/shared/mv-scene.mjs",
    ".dsh-plugin/shared/mv-scene-host.mjs",
    ".dsh-plugin/shared/mv-template-assets.gen.mjs",
    ".dsh-plugin/shared/mv-workshop.mjs",
    ".dsh-plugin/shared/mv-workshop-host.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "gen:scenes": "python3 tools/py2js.py \"$REF_ASCII_DIR/scenes.py\" .dsh-plugin/client/mv/scenes.gen.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node scripts/prepack.mjs",
    "pack:local": "npm pack --pack-destination dist"
  },
  "license": "(MIT AND CC-BY-NC-SA-4.0)",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
